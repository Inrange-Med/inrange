# Copy to .env.local. This app runs on port 3001 (npm run dev).
# The InRange API: the Supabase edge function base (the app calls /api/... under it).
NEXT_PUBLIC_API_BASE_URL=https://wcsglsrjixfrobujchen.supabase.co/functions/v1
# Razorpay and 100ms keys live only in the API's function secrets (supabase/README.md); the API hands
# the public Razorpay key id out with each order. Never put a vendor key here.
# The clinical assessment the homepage's "Start free check" opens (defaults to /assessment). Read by src/components/landing/ui.tsx.
NEXT_PUBLIC_ASSESSMENT_URL=

# Backend only: the app never calls Redcliffe. Read only by the reference client in src/server/redcliffe/.
# Never NEXT_PUBLIC.
REDCLIFFE_BASE_URL=https://apiqa.redcliffelabs.com
REDCLIFFE_API_KEY=
REDCLIFFE_WEBHOOK_SECRET=

# Firebase phone sign-in (public web app settings from the Firebase project; not secrets).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
